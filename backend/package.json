{
  "name": "zerobug-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express + MongoDB + Ollama + Playwright backend for ZeroBug",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:reset": "node src/seed.js",
    "smoke": "node src/smoke.js",
    "test": "node --test",
    "test:integration": "node scripts/run-integration-tests.js",
    "install:browser": "playwright install chromium",
    "install:browsers": "node scripts/install-browsers.js"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "nodemailer": "^9.0.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.49.1",
    "pngjs": "^7.0.0"
  }
}

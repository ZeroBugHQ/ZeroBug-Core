# ZeroBug Core — environment configuration
#
# Copy to `.env` and fill in the values you need:
#     cp .env.example .env
#
# Only ZEROBUG_SECRETS_KEY is strictly required to boot. Everything else has a
# sensible default (shown in [brackets]). With docker compose, this single .env
# feeds both the backend and the frontend build.

# ─────────────────────────────────────────────────────────────────────────────
# Secrets encryption — REQUIRED
# ─────────────────────────────────────────────────────────────────────────────
# 32-byte passphrase used to encrypt stored credentials (BYOK API keys, per-env
# secrets) at rest. The server WILL NOT START if this is empty — there is no
# insecure default. Generate a strong value with:
#     openssl rand -base64 32
ZEROBUG_SECRETS_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# HTTP server (backend)
# ─────────────────────────────────────────────────────────────────────────────
PORT=4000                       # optional — backend listen port [4000]
HOST=0.0.0.0                    # optional — backend bind host [localhost]; use 0.0.0.0 in Docker
CORS_ORIGIN=                    # optional — allowed frontend origin; blank reflects the request origin

# ─────────────────────────────────────────────────────────────────────────────
# Database (MongoDB) — required to persist data (defaults to local Mongo)
# ─────────────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017   # required — Mongo connection string [mongodb://127.0.0.1:27017]
MONGODB_DB=zerobug                       # optional — database name [zerobug]

# ─────────────────────────────────────────────────────────────────────────────
# Optional shared-password gate (single-team self-host)
# ─────────────────────────────────────────────────────────────────────────────
# Leave EMPTY for an open install (no login). Set a value to require a shared
# password. This is a simple gate, not multi-user auth.
ZEROBUG_AUTH_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Model provider — "ollama" (default, local) or "anthropic" (BYOK)
# ─────────────────────────────────────────────────────────────────────────────
MODEL_PROVIDER=ollama           # optional — "ollama" | "anthropic" [ollama]

# Ollama (used when MODEL_PROVIDER=ollama) — all optional
OLLAMA_BASE_URL=http://127.0.0.1:11434   # [http://127.0.0.1:11434]
OLLAMA_CHAT_MODEL=llama3.1               # [llama3.1]
OLLAMA_CODE_MODEL=llama3.1               # [llama3.1]
OLLAMA_NUM_CTX=8192                      # context window tokens [8192]
OLLAMA_VISION=false                      # send page screenshots to a vision model [false]

# Anthropic (BYOK — used when MODEL_PROVIDER=anthropic)
ANTHROPIC_API_KEY=              # required only if MODEL_PROVIDER=anthropic — YOUR key (sk-ant-...)
ANTHROPIC_BASE_URL=https://api.anthropic.com   # optional [https://api.anthropic.com]
ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-latest    # optional
ANTHROPIC_CODE_MODEL=claude-3-5-sonnet-latest   # optional
ANTHROPIC_VERSION=2023-06-01    # optional — Anthropic API version header

# ─────────────────────────────────────────────────────────────────────────────
# Test runner behaviour — all optional
# ─────────────────────────────────────────────────────────────────────────────
RUN_CONCURRENCY=3               # parallel tests in a "Run all" batch [3]
PLAYWRIGHT_HEADLESS=true        # run Chromium headless [true]
PLAYWRIGHT_TIMEOUT_MS=30000     # element action timeout [30000]
PLAYWRIGHT_NAV_TIMEOUT_MS=60000 # navigation timeout [60000]
AGENT_MEMORY_ENABLED=true       # learn per-site lessons across runs [true]
VISUAL_DIFF_THRESHOLD=1         # pixel diff threshold for visual assertions [1]
ENV_HEALTH_TIMEOUT_MS=5000      # environment health-check timeout [5000]

# ─────────────────────────────────────────────────────────────────────────────
# Storage paths — optional (default under the backend dir; use volumes in Docker)
# ─────────────────────────────────────────────────────────────────────────────
ARTIFACTS_DIR=                  # served run artifacts (screenshots/video/trace) [backend/artifacts]
DATA_DIR=                       # private runtime data (saved sessions) [backend/.data]

# ─────────────────────────────────────────────────────────────────────────────
# Notifications / alerts — all optional (leave blank to disable)
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=                      # SMTP server host
SMTP_PORT=587                   # SMTP port [587]
SMTP_SECURE=false               # use TLS [false]
SMTP_USER=                      # SMTP username
SMTP_PASS=                      # SMTP password
SMTP_FROM=                      # "from" address for alert emails
NOTIFY_EMAILS=                  # comma-separated recipient emails
NOTIFY_WEBHOOK_URLS=            # comma-separated webhook URLs

# ─────────────────────────────────────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────────────────────────────────────
# Browser-reachable URL of the backend. Baked in at build time (Vite), so with
# Docker this must be the host-published backend URL, not the internal service name.
VITE_API_URL=http://localhost:4000
